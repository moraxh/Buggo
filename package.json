{
  "name": "@moraxh/buggo",
  "version": "0.1.2",
  "description": "An AI-native bug investigator: narrows a repository down to the files most worth inspecting for a reported bug.",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "buggo": "dist/cli/buggo.js",
    "buggo-mcp": "dist/cli/buggo-mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "investigate": "tsx src/cli/buggo.ts investigate",
    "mcp": "tsx src/cli/buggo-mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": ["bug", "debugging", "ai", "cli", "mcp", "localization", "agent"],
  "author": "Jorge Mora",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moraxh/Buggo.git"
  },
  "homepage": "https://github.com/moraxh/Buggo#readme",
  "bugs": {
    "url": "https://github.com/moraxh/Buggo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "ink": "7.1.1",
    "ink-spinner": "5.0.0",
    "react": "19.2.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-typescript": "0.21.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.2.6"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.24.0"
}
